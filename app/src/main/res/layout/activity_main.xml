<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/clay_bg">

    <!-- Scrollable Content Area -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingBottom="120dp"
        android:fillViewport="true">

        <LinearLayout
            android:id="@+id/rootLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="24dp"
            android:paddingTop="24dp"
            android:clipToPadding="false"
            android:gravity="center_horizontal"
            android:animateLayoutChanges="true"
            tools:ignore="HardcodedText">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Hello, Traveller"
                android:textStyle="bold"
                android:fontFamily="@font/polysans"
                android:textSize="44sp"
                android:layout_marginTop="24dp"
                android:textColor="@color/clay_text_header" />

            <Space
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1.5" />

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardAccel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="8dp"
                android:layout_marginBottom="20dp"
                android:clickable="true"
                android:focusable="true"
                app:cardBackgroundColor="@color/clay_card"
                app:cardCornerRadius="32dp"
                app:cardElevation="12dp"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="24dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Accelerometer"
                        android:textStyle="bold"
                        android:gravity="center_horizontal"
                        android:textColor="@color/clay_text_body"
                        android:textSize="18sp" />

                    <TextView
                        android:id="@+id/tvAccelData"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:fontFamily="monospace"
                        android:text="X: 0.0\nY: 0.0\nZ: 0.0"
                        android:textColor="@color/clay_text_body"
                        android:textSize="16sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardGyro"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="8dp"
                android:layout_marginBottom="16dp"
                android:clickable="true"
                android:focusable="true"
                app:cardBackgroundColor="@color/clay_card"
                app:cardCornerRadius="32dp"
                app:cardElevation="12dp"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="24dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Gyroscope"
                        android:textStyle="bold"
                        android:gravity="center_horizontal"
                        android:textColor="@color/clay_text_body"
                        android:textSize="18sp" />

                    <TextView
                        android:id="@+id/tvGyroData"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:fontFamily="monospace"
                        android:text="X: 0.0\nY: 0.0\nZ: 0.0"
                        android:textColor="@color/clay_text_body"
                        android:textSize="16sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:paddingVertical="8dp"
                android:text="Location"
                android:textStyle="bold"
                android:textColor="@color/clay_text_header"
                android:textSize="20sp" />

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardMap"
                android:layout_width="match_parent"
                android:layout_height="200dp"
                android:layout_marginHorizontal="8dp"
                android:layout_marginBottom="16dp"
                app:cardBackgroundColor="@color/clay_card"
                app:cardCornerRadius="32dp"
                app:cardElevation="12dp"
                app:strokeWidth="0dp">

                <!-- Custom Map Container fixing gesture-conflict with scroll view -->
                <com.example.deadnavs.TouchableMapContainer
                    android:id="@+id/mapContainer"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/btnExpandMap"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_gravity="top|end"
                    android:layout_margin="12dp"
                    app:cardBackgroundColor="#88000000"
                    app:cardCornerRadius="12dp"
                    app:strokeWidth="0dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:text="⛶"
                        android:textColor="#FFFFFF"
                        android:textSize="24sp" />
                </com.google.android.material.card.MaterialCardView>
            </com.google.android.material.card.MaterialCardView>

            <Space
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="0.5" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Floating Translucent Button Container with Real-time Blur -->
    <FrameLayout
        android:id="@+id/bottomContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:paddingHorizontal="32dp"
        android:paddingTop="12dp"
        android:paddingBottom="24dp"
        android:background="@android:color/transparent">

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="72dp"
            app:cardCornerRadius="36dp"
            app:cardElevation="0dp"
            app:strokeWidth="0dp"
            app:cardBackgroundColor="@android:color/transparent">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnToggleLogging"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:text="Start Logging"
                android:textColor="#2E7D32"
                android:textSize="20sp"
                android:textStyle="bold"
                app:backgroundTint="#CCC8E6C9"
                app:cornerRadius="36dp"
                app:elevation="0dp" />
        </com.google.android.material.card.MaterialCardView>
    </FrameLayout>
</RelativeLayout>